{
  "name": "PWA Kitchen Sink",
  "short_name": "Sink",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#4f46e5",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg"],
        "audio/mp4": [".m4a"],
        "audio/flac": [".flac"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
